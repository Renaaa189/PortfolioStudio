# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_NAME=portfolio_studio

# Autenticación (cambiá el secreto por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
