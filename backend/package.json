{
  "name": "portfolio-studio-backend",
  "version": "1.0.0",
  "description": "API REST de Portfolio Studio (Node.js + Express + MySQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node database/setup.js",
    "db:seed": "node database/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:reset": "node database/setup.js --reset"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "portfolio-studio": "file:.."
  }
}
